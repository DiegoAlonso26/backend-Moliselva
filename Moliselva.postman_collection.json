{
  "info": {
    "name": "SW E3 PO-01 Moliselva - API",
    "description": "Contrato de CONTEXTO_MOLISELVA.md, sección 18. Configure demoPassword con la clave local de backend/.env. Todos los pesos son datos de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"demoPassword","value":""},
    {"key":"operarioToken","value":""},
    {"key":"jefeToken","value":""},
    {"key":"contadoraToken","value":""},
    {"key":"adminToken","value":""},
    {"key":"idProveedor","value":"1"},
    {"key":"idPendiente","value":"1"},
    {"key":"fecha","value":"2026-10-27"}
  ],
  "item": [
    {
      "name":"01 Login operario",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"usuario\":\"operario_demo\",\"password\":\"{{demoPassword}}\"}"},"url":"{{baseUrl}}/api/auth/login"},
      "event":[{"listen":"test","script":{"exec":["pm.test('Login 200 y rol OPERARIO', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().usuario.rol).to.eql('OPERARIO'); });","if (pm.response.code === 200) pm.collectionVariables.set('operarioToken', pm.response.json().token);"]}}]
    },
    {
      "name":"02 Login jefe",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"usuario\":\"jefe_demo\",\"password\":\"{{demoPassword}}\"}"},"url":"{{baseUrl}}/api/auth/login"},
      "event":[{"listen":"test","script":{"exec":["pm.test('Login 200 y rol JEFE_PLANTA', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().usuario.rol).to.eql('JEFE_PLANTA'); });","if (pm.response.code === 200) pm.collectionVariables.set('jefeToken', pm.response.json().token);"]}}]
    },
    {
      "name":"03 Login contadora",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"usuario\":\"contadora_demo\",\"password\":\"{{demoPassword}}\"}"},"url":"{{baseUrl}}/api/auth/login"},
      "event":[{"listen":"test","script":{"exec":["pm.test('Login 200 y rol CONTADORA', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().usuario.rol).to.eql('CONTADORA'); });","if (pm.response.code === 200) pm.collectionVariables.set('contadoraToken', pm.response.json().token);"]}}]
    },
    {
      "name":"04 Login administrador",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"usuario\":\"admin_demo\",\"password\":\"{{demoPassword}}\"}"},"url":"{{baseUrl}}/api/auth/login"},
      "event":[{"listen":"test","script":{"exec":["pm.test('Login 200 y rol ADMINISTRADOR', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().usuario.rol).to.eql('ADMINISTRADOR'); });","if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"]}}]
    },
    {
      "name":"05 Proveedores",
      "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{operarioToken}}"}],"url":"{{baseUrl}}/api/proveedores"},
      "event":[{"listen":"test","script":{"exec":["pm.test('Proveedor de prueba visible', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); });","if (pm.response.code === 200) pm.collectionVariables.set('idProveedor', pm.response.json()[0].idProveedor);"]}}]
    },
    {
      "name":"06 Recepción normal",
      "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{operarioToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"idProveedor\":{{idProveedor}},\"pesoBrutoKg\":32500,\"taraKg\":12500,\"pesoSacosKg\":0,\"humedadPct\":14.2,\"mermaLimpiezaKg\":150}"},"url":"{{baseUrl}}/api/recepciones"},
      "event":[{"listen":"test","script":{"exec":["pm.test('201 ACEPTADA, neto 20000 y entrada 19850', () => { pm.response.to.have.status(201); const r=pm.response.json(); pm.expect(r.estado).to.eql('ACEPTADA'); pm.expect(Number(r.pesoNetoKg)).to.eql(20000); pm.expect(Number(r.entradaKardexKg)).to.eql(19850); });"]}}]
    },
    {
      "name":"07 Recepción pendiente",
      "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{operarioToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"idProveedor\":{{idProveedor}},\"pesoBrutoKg\":1000,\"taraKg\":200,\"pesoSacosKg\":0,\"humedadPct\":14.8,\"mermaLimpiezaKg\":10}"},"url":"{{baseUrl}}/api/recepciones"},
      "event":[{"listen":"test","script":{"exec":["pm.test('201 PENDIENTE sin kardex', () => { pm.response.to.have.status(201); const r=pm.response.json(); pm.expect(r.estado).to.eql('PENDIENTE'); pm.expect(r.entradaKardexKg).to.eql(null); });","if (pm.response.code === 201) pm.collectionVariables.set('idPendiente', pm.response.json().idRecepcion);"]}}]
    },
    {
      "name":"08 Operario no decide",
      "request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{operarioToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"decision\":\"ACEPTAR\",\"motivo\":\"Motivo de prueba\"}"},"url":"{{baseUrl}}/api/recepciones/{{idPendiente}}/decision"},
      "event":[{"listen":"test","script":{"exec":["pm.test('403 sin permiso', () => pm.response.to.have.status(403));"]}}]
    },
    {
      "name":"09 Jefe acepta pendiente",
      "request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{jefeToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"decision\":\"ACEPTAR\",\"motivo\":\"Motivo de prueba\"}"},"url":"{{baseUrl}}/api/recepciones/{{idPendiente}}/decision"},
      "event":[{"listen":"test","script":{"exec":["pm.test('200 ACEPTADA y entrada al kardex', () => { pm.response.to.have.status(200); const r=pm.response.json(); pm.expect(r.estado).to.eql('ACEPTADA'); pm.expect(Number(r.entradaKardexKg)).to.eql(790); });"]}}]
    },
    {
      "name":"10 Decisión duplicada",
      "request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{jefeToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"decision\":\"ACEPTAR\",\"motivo\":\"Repetición de prueba\"}"},"url":"{{baseUrl}}/api/recepciones/{{idPendiente}}/decision"},
      "event":[{"listen":"test","script":{"exec":["pm.test('409 evita duplicar el kardex', () => pm.response.to.have.status(409));"]}}]
    },
    {
      "name":"11 Recepción rechazada por humedad",
      "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{operarioToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"idProveedor\":{{idProveedor}},\"pesoBrutoKg\":1000,\"taraKg\":200,\"pesoSacosKg\":0,\"humedadPct\":16,\"mermaLimpiezaKg\":10}"},"url":"{{baseUrl}}/api/recepciones"},
      "event":[{"listen":"test","script":{"exec":["pm.test('201 RECHAZADA sin kardex', () => { pm.response.to.have.status(201); const r=pm.response.json(); pm.expect(r.estado).to.eql('RECHAZADA'); pm.expect(r.entradaKardexKg).to.eql(null); });"]}}]
    },
    {
      "name":"12 Recepciones del día",
      "event":[{"listen":"prerequest","script":{"exec":["pm.collectionVariables.set('fecha', new Intl.DateTimeFormat('en-CA', {timeZone:'America/Lima',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()));"]}},{"listen":"test","script":{"exec":["pm.test('200 lista de recepciones', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"]}}],
      "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{contadoraToken}}"}],"url":"{{baseUrl}}/api/recepciones?fecha={{fecha}}"}
    },
    {
      "name":"13 Kardex maíz",
      "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/api/inventario/maiz/kardex"},
      "event":[{"listen":"test","script":{"exec":["pm.test('200 con saldo', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()[0]).to.have.property('saldoKg'); });"]}}]
    },
    {
      "name":"14 Stock maíz",
      "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{operarioToken}}"}],"url":"{{baseUrl}}/api/inventario/maiz/stock"},
      "event":[{"listen":"test","script":{"exec":["pm.test('200 con stockKg', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.property('stockKg'); });"]}}]
    },
    {
      "name":"15 Operario no exporta",
      "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{operarioToken}}"}],"url":"{{baseUrl}}/api/inventario/maiz/kardex/exportar"},
      "event":[{"listen":"test","script":{"exec":["pm.test('403 sin permiso', () => pm.response.to.have.status(403));"]}}]
    },
    {
      "name":"16 Contadora exporta CSV",
      "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{contadoraToken}}"}],"url":"{{baseUrl}}/api/inventario/maiz/kardex/exportar"},
      "event":[{"listen":"test","script":{"exec":["pm.test('200 text/csv', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'); });"]}}]
    }
  ]
}
